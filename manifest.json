{
  "manifest_version": 3,
  "name": "Gamma - Controle de Chamados",
  "version": "1.0.0",
  "description": "Cadastro rápido de chamados e geração automática do relatório diário.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "downloads", "clipboardWrite", "tabs"]
}
